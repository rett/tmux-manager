# Compatibility entry point. Prefer the user tmux-manager.service with linger.
[Unit]
Description=Managed tmux sessions for user %i (compatibility)
After=network.target systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=%i
WorkingDirectory=~
ExecStart=/opt/tmux-manager/bin/tmux-manager boot
ExecStop=/opt/tmux-manager/bin/tmux-manager shutdown
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
